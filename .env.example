# ---- Cloud pipeline (Cloud Run sets these at deploy; local dev via .env) ----
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=new-prompt-490003
GOOGLE_CLOUD_LOCATION=global            # Gemini client ONLY; infra stays us-central1
MODEL_PLANNER=gemini-3.5-flash
MODEL_CRITIC=gemini-3.5-flash
MODEL_GATHERER=gemini-3.5-flash-lite
POLICY_FILE=config/policy.yaml
PRICES_FILE=config/prices.yaml
LEDGER_SINK=pubsub                      # pubsub | file
PUBSUB_TOPIC=agent-events
SCHEDULER_INVOKER_SA=sa-home@new-prompt-490003.iam.gserviceaccount.com
SERVICE_URL=                            # set after first deploy (OIDC audience)
HEARTH_TRIGGER_TOKEN=                   # random secret for the manual /trigger path
EGRESS_SALT=                            # from house/export_egress_hashes.py
EGRESS_ALIAS_HASHES=                    # comma-separated salted hashes (no plaintext!)
EGRESS_KNOWN_TOKENS=                    # comma-separated [[TOKEN]] vocabulary (same script);
                                        # production REQUIRES all three — the service fails
                                        # closed rather than run with the guard off

# ---- Judge mode (docker compose sets all of this automatically) -------------
# SIMULATED_HOME=1
# JUDGE_LLM=fixture                     # fixture | live (live needs GEMINI_API_KEY)
# FIRESTORE_EMULATOR_HOST=firestore:8790

# ---- House side (house/.env on the real house machine, gitignored) ----------
# HA_URL=http://<home-assistant-ip>:8123
# HA_TOKEN=<long-lived access token>    # or leave unset to use the local agent vault
# NOTIFY_SERVICE=mobile_app_<your-device>
# CALENDAR_ENTITY=calendar.hearthbeat_family
# TOKEN_MAP_PATH=config/token_map.local.json
# PRIVACY_TIER=gemma                    # gemma | qwen
# OLLAMA_BASE=http://127.0.0.1:11434
# QWEN_BASE=http://127.0.0.1:8000/v1
# QWEN_MODEL=qwen2.5-7b
